# Environment
venv/
.venv/
.env

# Data and models (large, regenerated locally).
# The skills taxonomy is hand-written source, not generated data, so it is tracked.
# Git will not descend into an excluded directory, so exclude the contents
# rather than the directory itself for the negation below to take effect.
data/*
!data/skills_taxonomy.txt
models/

# Personal notes and build guides
git_ignore_files/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
